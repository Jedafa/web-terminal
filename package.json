{
  "name": "web-terminal",
  "version": "1.1.0",
  "description": "Браузерный терминал с реальным PTY: xterm.js + node-pty + socket.io. Вкладки, пароль-авторизация, выбор shell. Self-hosted, как sshx.",
  "license": "MIT",
  "author": "Jedafa",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jedafa/web-terminal.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "web-terminal": "./bin/web-terminal.js"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "socket.io": "^4.8.1"
  }
}
